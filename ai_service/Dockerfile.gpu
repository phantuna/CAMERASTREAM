# =============================================================================
# DOCKERFILE CHO MODULE AI ALPR CHẾ ĐỘ NVIDIA GPU (CUDA + CUDNN)
# Tự động nhận diện GPU NVIDIA và tự động fallback về CPU nếu không có GPU.
# =============================================================================

FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

WORKDIR /app

# Ngăn prompt tương tác khi apt-get install
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# Cài đặt Python 3.10, pip và các thư viện C/C++ cần thiết cho OpenCV, FFMPEG
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Cấu hình python mặc định
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# Cài đặt pip dependencies cho GPU (onnxruntime-gpu)
COPY requirements-gpu.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements-gpu.txt

# Sao chép toàn bộ mã nguồn, cấu hình và model ONNX vào container
COPY . /app

# Cấu hình biến môi trường tối ưu cho GPU
ENV BACKEND_URL=http://host.docker.internal:8080 \
    MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554 \
    WEB_PORT=5000 \
    OPENCV_FFMPEG_CAPTURE_OPTIONS="rtsp_transport;tcp|fflags;nobuffer|flags;low_delay|max_delay;0|framedrop;1" \
    AI_OCR_MAX_TOTAL=8 \
    AI_OCR_WORKERS=8 \
    AI_NEAR_PX=80 \
    AI_OCR_PER_FRAME=8 \
    AI_MAX_TRACKS=12 \
    AI_OUTDOOR_MODE=1 \
    AI_FRAME_SKIP=1 \
    AI_FRAME_MAX_WIDTH=1280 \
    AI_MIN_PLATE_WIDTH=14 \
    AI_DETECTOR_CONF=0.20 \
    AI_CPU_THREADS=2 \
    AI_TIER1_ON_DEMAND=1 \
    AI_TRACKER=bytetrack \
    AI_BENCH=0

EXPOSE 5000

CMD ["python", "main.py"]

