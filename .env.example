# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG CAMERASTREAM
# ==============================================================================

# IP của máy chủ chạy Docker (Dùng khi các máy khác trong mạng LAN truy cập)
# - Chạy cục bộ trên máy mình: HOST_IP=localhost
# - Cho các máy khác trong cùng mạng LAN xem được: HOST_IP=192.168.1.100 (đổi thành IP thật của máy bạn)
HOST_IP=localhost

# Cổng truy cập Web Frontend
# - Mặc định cổng 80: Mở trình duyệt http://localhost
# - Nếu cổng 80 bị ứng dụng khác chiếm (như IIS/Skype): đổi thành 3000 (truy cập http://localhost:3000)
FRONTEND_PORT=80

# Cấu hình Cơ Sở Dữ Liệu PostgreSQL
DB_NAME=camerastream_db
DB_USER=postgres
DB_PASSWORD=postgres

# ======================= CẤU HÌNH HIỆU NĂNG AI =======================
# Số luồng xử lý OCR song song (4 cho CPU thường, 8 cho CPU khỏe, 16 cho máy có GPU)
AI_OCR_MAX_TOTAL=8

# Tracker engine: bytetrack (mượt mà, nội suy vị trí xe khi bị skip frame)
AI_TRACKER=bytetrack

# Chỉ nhận diện và bám biển số trong vùng khung ảo ROI (0 = Tiết kiệm 50% CPU)
AI_TRACK_OUTSIDE_ROI=0
